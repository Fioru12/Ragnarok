# Configuration
# Copy this file to .env and fill in your values.
# docker compose reads .env automatically for variable interpolation.

# Required
SECRET_KEY=change-this-to-a-random-secret-key

# Optional
LOG_LEVEL=INFO
DEBUG=false

# --- Ragnarök backend (read by backend/server.py + docker-compose.yml) ---
# Port exposed on the host (container always listens on 8080 internally)
RAGNAROK_PORT=8080
# API key for action endpoints (execute/chat). If empty, the backend
# generates a random one on startup and prints it to the console.
RAGNAROK_API_KEY=
# Secret for signing auth sessions. SET THIS IN PRODUCTION or sessions
# are lost on every restart.
RAGNAROK_AUTH_SECRET=
# Session lifetime in seconds (default 8h)
RAGNAROK_SESSION_TTL=28800
# Brute-force protection
RAGNAROK_LOGIN_MAX_ATTEMPTS=5
RAGNAROK_LOCKOUT_SECONDS=300
# Global rate limiting (requests per window per IP)
RAGNAROK_RATE_LIMIT_MAX=300
RAGNAROK_RATE_LIMIT_WINDOW=60
# RAG automation (0 = disabled)
RAG_AUTO_INDEX_MINUTES=0
RAG_ANOMALY_WATCH_MINUTES=15
# Scheduled report digest (minutes interval; 1440 = daily)
RAG_REPORT_SEND_MINUTES=1440
# ...or fixed daily time HH:MM (takes precedence check per day)
RAG_REPORT_SEND_CRON=
# Persistent state (named volumes in compose; mai /tmp in prod)
ASGARD_RAG_DB_PATH=/state/rag_db
RAGNAROK_AUTH_DB_PATH=/state/ragnarok_auth.db
RAGNAROK_AUDIT_DB_PATH=/state/ragnarok_audit.db
# Backup retention (max archivi / max giorni; 0 = disabilitato)
BACKUP_KEEP_COUNT=14
BACKUP_RETENTION_DAYS=30
# HTTPS on untrusted networks (true = self-signed cert, dev only)
ASGARD_TLS=false
# Secrets: genera con `python scripts/rotate_keys.py --write .env`
# (mai i default asgard-*-key in produzione).
